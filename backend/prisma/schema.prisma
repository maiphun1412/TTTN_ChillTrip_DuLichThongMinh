  total_payable_amount             Decimal                  @default(0, map: "DF__bookings__total___42E1EEFE") @db.Decimal(18, 2)
  reserved_until                   DateTime?
  special_notes                    String?                  @db.NVarChar(Max)
  booked_at                        DateTime                 @default(now(), map: "DF__bookings__booked__43D61337")
  confirmed_at                     DateTime?
  cancelled_at                     DateTime?
  completed_at                     DateTime?
  created_by                       BigInt?
  updated_by                       BigInt?
