  departure_schedules              departure_schedules      @relation(fields: [departure_id], references: [id], onUpdate: NoAction, map: "FK_bookings_departure")
  pickup_points                    pickup_points?           @relation(fields: [pickup_point_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_bookings_pickup_point")
  promotions                       promotions?              @relation(fields: [promotion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_bookings_promotion")
  tours                            tours                    @relation(fields: [tour_id], references: [id], onUpdate: NoAction, map: "FK_bookings_tour")
  users_bookings_updated_byTousers users?                   @relation("bookings_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_bookings_updated_by")
  cancellation_requests            cancellation_requests[]
  customer_travel_places           customer_travel_places[]
  debts                            debts?
  email_logs                       email_logs[]
  group_contracts                  group_contracts[]
  loyalty_transactions             loyalty_transactions[]
  payments                         payments[]
  refunds                          refunds[]
  reviews                          reviews[]
