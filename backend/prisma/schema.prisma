  users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_audit_logs_user")
}

model banners {
  id            BigInt    @id(map: "PK__banners__3213E83FAB73C40F") @default(autoincrement())
  title         String?   @db.NVarChar(255)
  image_url     String    @db.NVarChar(Max)
  link_url      String?   @db.NVarChar(Max)
  position_name String?   @db.VarChar(100)
