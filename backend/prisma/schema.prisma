  bookings        bookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_booking_promotions_booking")
  promotions      promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_booking_promotions_promotion")

  @@id([booking_id, promotion_id], map: "PK__booking___FF2830E71683D5AB")
}

model booking_service_items {
  id             BigInt   @id(map: "PK__booking___3213E83F13BCFE05") @default(autoincrement())
  booking_id     BigInt
  service_type   String   @db.VarChar(30)
  service_ref_id BigInt?
