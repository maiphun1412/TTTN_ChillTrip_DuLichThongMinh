generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model ai_chat_sessions {
  id                   BigInt     @id(map: "PK__ai_chat___3213E83FF0503BE1") @default(autoincrement())
  customer_id          BigInt?
  firebase_session_key String     @unique(map: "UQ__ai_chat___39D1113E2A51D8C6") @db.VarChar(255)
  topic                String?    @db.NVarChar(255)
  handed_over_to_staff Boolean    @default(false, map: "DF__ai_chat_s__hande__65F62111")
  created_at           DateTime   @default(now(), map: "DF__ai_chat_s__creat__66EA454A")
  updated_at           DateTime   @default(now(), map: "DF__ai_chat_s__updat__67DE6983")
  customers            customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ai_chat_sessions_customer")
}

model articles {
  id                 BigInt    @id(map: "PK__articles__3213E83FE484744F") @default(autoincrement())
  title              String    @db.NVarChar(255)
  slug               String    @unique(map: "UQ__articles__32DD1E4CDD1E543D") @db.VarChar(255)
  summary            String?   @db.NVarChar(Max)
  content            String    @db.NVarChar(Max)
  featured_image_url String?   @db.NVarChar(Max)
  status             String    @default("DRAFT", map: "DF__articles__status__4C364F0E") @db.VarChar(30)
  published_at       DateTime?
  created_by         BigInt?
  created_at         DateTime  @default(now(), map: "DF__articles__create__4D2A7347")
  updated_at         DateTime  @default(now(), map: "DF__articles__update__4E1E9780")
  category           String?   @db.NVarChar(50)
  users              users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_articles_created_by")
}

model audit_logs {
  id          BigInt   @id(map: "PK__audit_lo__3213E83FA3850C4A") @default(autoincrement())
  user_id     BigInt?
  module_name String   @db.VarChar(100)
  action_name String   @db.VarChar(50)
  entity_name String   @db.VarChar(100)
  entity_id   BigInt?
  old_data    String?  @db.NVarChar(Max)
  new_data    String?  @db.NVarChar(Max)
