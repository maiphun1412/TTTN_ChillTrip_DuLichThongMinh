  gender                  String?               @db.VarChar(20)
  date_of_birth           DateTime?             @db.Date
  phone                   String?               @db.VarChar(20)
  email                   String?               @db.VarChar(255)
  id_number               String?               @db.VarChar(50)
  passport_number         String?               @db.VarChar(50)
  nationality             String?               @db.NVarChar(100)
  emergency_contact_name  String?               @db.NVarChar(255)
  emergency_contact_phone String?               @db.VarChar(20)
  meal_note               String?               @db.NVarChar(255)
  health_note             String?               @db.NVarChar(Max)
  room_preference         String?               @db.NVarChar(100)
