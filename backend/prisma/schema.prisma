  is_active     Boolean   @default(true, map: "DF__banners__is_acti__52E34C9D")
  start_at      DateTime?
  end_at        DateTime?
}

model pickup_province_fees {
  id                  BigInt              @id(map: "PK__pickup_p__3213E83FB64FB0D5") @default(autoincrement())
