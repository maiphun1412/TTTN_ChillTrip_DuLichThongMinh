  role_id                                                         BigInt
  email                                                           String?                    @unique(map: "UQ__users__AB6E6164A02E089A") @db.VarChar(255)
  phone                                                           String?                    @unique(map: "UQ__users__B43B145F53E16A53") @db.VarChar(20)
  password_hash                                                   String                     @db.NVarChar(Max)
  full_name                                                       String                     @db.NVarChar(255)
  avatar_url                                                      String?                    @db.NVarChar(Max)
  status                                                          String                     @default("ACTIVE", map: "DF__users__status__4316F928") @db.VarChar(30)
  last_login_at                                                   DateTime?
  created_at                                                      DateTime                   @default(now(), map: "DF__users__created_a__440B1D61")
  updated_at                                                      DateTime                   @default(now(), map: "DF__users__updated_a__44FF419A")
  articles                                                        articles[]
  audit_logs                                                      audit_logs[]
  bookings_bookings_created_byTousers                             bookings[]                 @relation("bookings_created_byTousers")
  bookings_bookings_updated_byTousers                             bookings[]                 @relation("bookings_updated_byTousers")
  cancellation_requests_cancellation_requests_processed_byTousers cancellation_requests[]    @relation("cancellation_requests_processed_byTousers")
  cancellation_requests_cancellation_requests_requested_byTousers cancellation_requests[]    @relation("cancellation_requests_requested_byTousers")
  customers                                                       customers[]
  debt_transactions                                               debt_transactions[]
  departure_expenses                                              departure_expenses[]
  departure_operation_logs                                        departure_operation_logs[]
  email_otps                                                      email_otps[]
  employees                                                       employees?
  favorites                                                       favorites[]
  group_contracts                                                 group_contracts[]
  guide_assignments                                               guide_assignments[]
  notifications                                                   notifications[]
  operation_incidents                                             operation_incidents[]
  payments                                                        payments[]
  tour_guides                                                     tour_guides?
  tours_tours_created_byTousers                                   tours[]                    @relation("tours_created_byTousers")
  tours_tours_updated_byTousers                                   tours[]                    @relation("tours_updated_byTousers")
  roles                                                           roles                      @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "FK_users_roles")
}

model vehicle_services {
  id                  BigInt              @id(map: "PK__vehicle___3213E83F301893F2") @default(autoincrement())
  departure_id        BigInt
  supplier_id         BigInt?
  vehicle_type        String?             @db.NVarChar(100)
  vehicle_number      String?             @db.VarChar(50)
  seat_count          Int?
  departure_time      DateTime?
  pickup_location     String?             @db.NVarChar(Max)
  service_status      String              @default("PLANNED", map: "DF__vehicle_s__servi__0B5CAFEA") @db.VarChar(30)
  unit_price          Decimal             @default(0, map: "DF__vehicle_s__unit___0C50D423") @db.Decimal(18, 2)
  departure_schedules departure_schedules @relation(fields: [departure_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_vehicle_services_departure")
  suppliers           suppliers?          @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_vehicle_services_supplier")
}

model favorites {
  id         BigInt    @id(map: "PK__favorite__3213E83F033A1FD6") @default(autoincrement())
  user_id    BigInt
  tour_id    BigInt
  created_at DateTime? @default(now(), map: "DF__favorites__creat__7BE56230")
  tours      tours     @relation(fields: [tour_id], references: [id], onUpdate: NoAction, map: "FK_favorites_tour")
  users      users     @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK_favorites_user")

  @@unique([user_id, tour_id], map: "UQ_user_tour")
}

model customer_messages {
  id              BigInt    @id(map: "PK__customer__3213E83F5AA5D396") @default(autoincrement())
  customer_id     BigInt
  sender_type     String    @db.VarChar(20)
  message_content String    @db.NVarChar(Max)
  is_read         Boolean   @default(false, map: "DF__customer___is_re__13BCEBC1")
  created_at      DateTime  @default(now(), map: "DF__customer___creat__14B10FFA")
  customers       customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_customer_messages_customer")
}

model operation_incidents {
  id                  BigInt               @id(map: "PK__operatio__3213E83FC399275B") @default(autoincrement())
  dispatch_id         BigInt?
  departure_id        BigInt?
  incident_code       String               @unique(map: "UQ__operatio__6B65846241EAC56D") @db.VarChar(50)
  incident_type       String               @db.VarChar(50)
  priority_level      String               @default("NORMAL", map: "DF__operation__prior__26CFC035") @db.VarChar(30)
  title               String               @db.NVarChar(255)
  description         String?              @db.NVarChar(Max)
  incident_status     String               @default("OPEN", map: "DF__operation__incid__27C3E46E") @db.VarChar(30)
  handled_action      String?              @db.NVarChar(Max)
  reported_at         DateTime             @default(now(), map: "DF__operation__repor__28B808A7")
  resolved_at         DateTime?
  created_by          BigInt?
  users               users?               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_operation_incidents_created_by")
  departure_schedules departure_schedules? @relation(fields: [departure_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_operation_incidents_departure")
}

model operation_reports {
  id                  BigInt              @id(map: "PK__operatio__3213E83F5846CD6B") @default(autoincrement())
  departure_id        BigInt
  report_status       String              @db.NVarChar(50)
  current_location    String?             @db.NVarChar(255)
  content             String              @db.NVarChar(Max)
  present_count       Int                 @default(0, map: "DF__operation__prese__0E04126B")
  absent_count        Int                 @default(0, map: "DF__operation__absen__0EF836A4")
  created_at          DateTime            @default(now(), map: "DF__operation__creat__0FEC5ADD")
  issue_type          String?             @db.NVarChar(100)
  priority_level      String?             @db.NVarChar(50)
  handled_action      String?             @db.NVarChar(Max)
  next_action         String?             @db.NVarChar(Max)
  departure_schedules departure_schedules @relation(fields: [departure_id], references: [id], onUpdate: NoAction, map: "FK_operation_reports_departure")
}

model review_images {
  id         BigInt    @id(map: "PK__review_i__3213E83F6DDEECEF") @default(autoincrement())
  review_id  BigInt
  image_url  String    @db.NVarChar(500)
  sort_order Int?      @default(1, map: "DF__review_im__sort___00AA174D")
  created_at DateTime? @default(now(), map: "DF__review_im__creat__019E3B86")
  reviews    reviews   @relation(fields: [review_id], references: [id], onUpdate: NoAction, map: "FK_review_images_reviews")
}

model loyalty_rules {
  id               BigInt   @id(map: "PK__loyalty___3213E83FF5A68D2F") @default(autoincrement())
  rule_name        String   @db.NVarChar(100)
  earn_rate        Decimal  @default(0, map: "DF__loyalty_r__earn___54968AE5") @db.Decimal(18, 2)
  min_order_amount Decimal  @default(0, map: "DF__loyalty_r__min_o__558AAF1E") @db.Decimal(18, 2)
  status           String   @default("ACTIVE", map: "DF__loyalty_r__statu__567ED357") @db.VarChar(30)
  created_at       DateTime @default(now(), map: "DF__loyalty_r__creat__5772F790")
}

model loyalty_transactions {
  id               BigInt    @id(map: "PK__loyalty___3213E83F4A7F0389") @default(autoincrement())
  customer_id      BigInt
  booking_id       BigInt?
  transaction_type String    @db.VarChar(30)
  points           Int
  description      String?   @db.NVarChar(255)
  created_at       DateTime  @default(now(), map: "DF__loyalty_t__creat__4FD1D5C8")
  point_status     String    @default("PENDING", map: "DF__loyalty_t__point__58671BC9") @db.VarChar(30)
  bookings         bookings? @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_loyalty_transactions_booking")
  customers        customers @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "FK_loyalty_transactions_customer")
}

model loyalty_wallets {
  id            BigInt    @id(map: "PK__loyalty___3213E83F4B8689DE") @default(autoincrement())
  customer_id   BigInt    @unique(map: "UQ__loyalty___CD65CB84DFBFB536")
  point_balance Int       @default(0, map: "DF__loyalty_w__point__4830B400")
  total_earned  Int       @default(0, map: "DF__loyalty_w__total__4924D839")
  total_used    Int       @default(0, map: "DF__loyalty_w__total__4A18FC72")
  created_at    DateTime  @default(now(), map: "DF__loyalty_w__creat__4B0D20AB")
  updated_at    DateTime  @default(now(), map: "DF__loyalty_w__updat__4C0144E4")
  customers     customers @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "FK_loyalty_wallets_customer")
}

model customer_travel_places {
  id                         BigInt       @id(map: "PK__customer__3213E83F7844CDB2") @default(autoincrement())
  customer_id                BigInt
  destination_id             BigInt
  first_completed_booking_id BigInt?
  visited_at                 DateTime     @default(now(), map: "DF__customer___visit__6F4A8121")
  bookings                   bookings?    @relation(fields: [first_completed_booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_travel_places_booking")
  customers                  customers    @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_customer_travel_places_customer")
  destinations               destinations @relation(fields: [destination_id], references: [id], onUpdate: NoAction, map: "FK_customer_travel_places_destination")

  @@unique([customer_id, destination_id], map: "UQ_customer_travel_places")
}

model email_otps {
  id          BigInt    @id(map: "PK__email_ot__3213E83F067B4386") @default(autoincrement())
  user_id     BigInt?
  email       String    @db.VarChar(255)
  otp_code    String    @db.VarChar(10)
  purpose     String    @db.VarChar(50)
  expires_at  DateTime
  verified_at DateTime?
  created_at  DateTime  @default(now(), map: "DF__email_otp__creat__1387E197")
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_email_otps_users")
}
